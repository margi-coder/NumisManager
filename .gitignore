# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
.venv/
venv/
ENV/
env/

# SQLite temporary journal & WAL files
*.db-journal
*.db-wal
*.db-shm

# Environment & Secrets
.env
!.env.example

# Database Backups
backups/
!backups/.gitkeep

# Large binary developer utilities & tools
cloudflared.exe
tools/bin/*
!tools/bin/.gitkeep
tools/*.exe
tools/cloudflared*

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# User uploaded images at runtime (excluding tracked sample media)
static/uploads/*.png
static/uploads/*.jpg
!static/uploads/gal_*.jpg
!static/uploads/item_*
!static/uploads/batch_*

# Generated Offline Installer Binaries (stored locally in Installer/)
Installer/*.exe
Installer/*.run
Installer/smart_phone/*.apk
Installer/smart_phone/*.ipa
Installer/smart_phone/*.mobileconfig
Installer/smart_phone/*.html
Installer/smart_phone/*.idsig

# Scratch and temporary databases
dashboard.db
scratch/
